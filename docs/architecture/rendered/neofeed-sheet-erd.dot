digraph NeoFeedERD {
  graph [
    rankdir=LR,
    bgcolor="#F7FAFC",
    pad=0.35,
    nodesep=0.75,
    ranksep=1.0,
    splines=polyline,
    fontname="Arial",
    fontcolor="#102A43",
    label=<<B>NeoFeed Google Sheets Data Model</B><BR/><FONT POINT-SIZE="12">Conceptual ERD · relationships are enforced by application code, not by Google Sheets</FONT>>,
    labelloc=t,
    fontsize=24
  ];

  node [shape=plain, fontname="Arial"];
  edge [color="#627D98", fontcolor="#486581", fontname="Arial", fontsize=9, arrowsize=0.75, penwidth=1.2];

  patient [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6AA7D5" BGCOLOR="#FFFFFF">
      <TR><TD COLSPAN="3" BGCOLOR="#D9ECFA"><B>Patient_Registry</B></TD></TR>
      <TR><TD><B>Key</B></TD><TD><B>Field</B></TD><TD><B>Type</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD PORT="sessionId" ALIGN="LEFT"><B>sessionId</B></TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">initials</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">bw</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">ga</TD><TD ALIGN="LEFT">number (WW.D)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">sex</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">dob</TD><TD ALIGN="LEFT">date</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">admissionDate</TD><TD ALIGN="LEFT">date</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">twinSuffix</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">currentBed</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">diagnosis</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">weights</TD><TD ALIGN="LEFT">JSON</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">lengths</TD><TD ALIGN="LEFT">JSON</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">hcs</TD><TD ALIGN="LEFT">JSON</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">bedHistory</TD><TD ALIGN="LEFT">JSON</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">statusDate</TD><TD ALIGN="LEFT">date</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">multiplesCount</TD><TD ALIGN="LEFT">number</TD></TR>
    </TABLE>
  >];

  daily [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#4FA6AE" BGCOLOR="#FFFFFF">
      <TR><TD COLSPAN="3" BGCOLOR="#D5F0F1"><B>Daily_Log</B></TD></TR>
      <TR><TD><B>Key</B></TD><TD><B>Field</B></TD><TD><B>Type</B></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">ts</TD><TD ALIGN="LEFT">date</TD></TR>
      <TR><TD><B>FK</B></TD><TD PORT="sessionId" ALIGN="LEFT"><B>sessionId</B></TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">dol</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">weight</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">fluid</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">gir</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">pro</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">kcal</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">na · k · ca · p</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">enVolPerKg</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">route</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD><B>FK</B></TD><TD PORT="submittedBy" ALIGN="LEFT"><B>submittedBy</B></TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">suppMTV</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">suppVitD_IU</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">suppCa_mg · suppCaType</TD><TD ALIGN="LEFT">number · string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">suppPO4_mmol · suppPO4Type</TD><TD ALIGN="LEFT">number · string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">suppFe_mg · suppFeType</TD><TD ALIGN="LEFT">number · string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">calcInputJson</TD><TD ALIGN="LEFT">JSON</TD></TR>
      <TR><TD><B>PK</B></TD><TD PORT="entryId" ALIGN="LEFT"><B>entryId</B></TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">lastModified</TD><TD ALIGN="LEFT">datetime</TD></TR>
      <TR><TD><B>FK</B></TD><TD PORT="lastModifiedBy" ALIGN="LEFT"><B>lastModifiedBy</B></TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">ioInput</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">ioOutput</TD><TD ALIGN="LEFT">number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">drainContent</TD><TD ALIGN="LEFT">number</TD></TR>
    </TABLE>
  >];

  staff [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#9274CF" BGCOLOR="#FFFFFF">
      <TR><TD COLSPAN="3" BGCOLOR="#E9E1FA"><B>Staff</B></TD></TR>
      <TR><TD><B>Key</B></TD><TD><B>Field</B></TD><TD><B>Type</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD PORT="email" ALIGN="LEFT"><B>email</B></TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">salt</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">must_change_password</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">temp_password</TD><TD ALIGN="LEFT">string</TD></TR>
    </TABLE>
  >];

  audit [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#D79A3E" BGCOLOR="#FFFFFF">
      <TR><TD COLSPAN="3" BGCOLOR="#FCE8C7"><B>Audit_Log</B></TD></TR>
      <TR><TD><B>Key</B></TD><TD><B>Field</B></TD><TD><B>Type</B></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">ts</TD><TD ALIGN="LEFT">datetime</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">string</TD></TR>
      <TR><TD><B>FK*</B></TD><TD PORT="sessionId" ALIGN="LEFT"><B>sessionId</B></TD><TD ALIGN="LEFT">string · optional</TD></TR>
      <TR><TD><B>FK</B></TD><TD PORT="actorEmail" ALIGN="LEFT"><B>actorEmail</B></TD><TD ALIGN="LEFT">string</TD></TR>
    </TABLE>
  >];

  daily:sessionId -> patient:sessionId [label="many logs → one patient", color="#2E7E87", penwidth=1.6];
  daily:submittedBy -> staff:email [label="created by", color="#7654B5"];
  daily:lastModifiedBy -> staff:email [label="last edited by", color="#7654B5"];
  audit:actorEmail -> staff:email [label="performed by", color="#B87718"];
  audit:sessionId -> patient:sessionId [label="optional patient context", style=dashed, color="#B87718"];

  note [
    shape=note,
    style=filled,
    fillcolor="#FFFDF4",
    color="#D7B75C",
    fontname="Arial",
    fontsize=10,
    label="sessionId is pseudonymous and immutable after issuance.\nentryId identifies one Daily_Log row.\nAudit_Log.sessionId is blank for registry-wide reads."
  ];
  audit -> note [style=dashed, arrowhead=none, color="#B4963E"];
}

