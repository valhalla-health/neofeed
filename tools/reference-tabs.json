{
  "about": [
    "What each clinical reference table in data.js must hold (NF-28). tools/reference-tabs.cjs checks every cell against it, and test/verify-reference-tabs.cjs runs that check in the `harnesses` CI job, which `release` requires.",
    "Every number column has a unit. A range comes from the neofeed-clinical-rules skill in one of two ways: a CR- rule that codes the cell (its `coded` value, read from the skill, so the number lives in one place) or a range a rule states (`rule`). A range no rule gives is `proposed` and waits for Pp.",
    "The proposed ranges follow one rule: half the lowest to 1.5 times the highest value on 2026-10-28, rounded outward to two significant figures. They catch a slipped decimal or a unit mix-up (mg typed as mmol), not a clinical judgement, and each says where today's values come from.",
    "range \"rule\" means each cell takes the exact value a CR- rule codes for it, or the range under `cells`; a cell with neither fails."
  ],
  "tables": {
    "EN_DB": {
      "what": "Feed composition per 100 mL: the milk composition table. The Calculator (Step 2), the nursing form and the Formula page read it.",
      "columns": {
        "label": { "type": "text" },
        "kcal": { "type": "number", "unit": "kcal/100 mL", "sign": "positive",
          "range": { "lo": 67, "hi": 100, "rule": "CR-U-EN-KCAL", "why": "the strengths the ward makes, 20 to 30 kcal/oz" } },
        "pro": { "type": "number", "unit": "g protein/100 mL", "sign": "positive",
          "range": { "lo": 0.6, "hi": 4, "proposed": "0.5x to 1.5x today's 1.2-2.64 (Chula Handbook 3rd ed. Tables 5, 7, 16 and p. 10; WHO 2006 Box 1.3.1)" } },
        "fat": { "type": "number", "unit": "g fat/100 mL", "sign": "positive",
          "range": { "lo": 1.7, "hi": 8.1, "proposed": "0.5x to 1.5x today's 3.4-5.4 (the same sources)" } },
        "cho": { "type": "number", "unit": "g carbohydrate/100 mL", "sign": "positive",
          "range": { "lo": 3.3, "hi": 16, "proposed": "0.5x to 1.5x today's 6.7-10.3 (the same sources)" } },
        "na": { "type": "number", "unit": "mmol Na/100 mL", "sign": "positive",
          "range": { "lo": 0.45, "hi": 4.5, "proposed": "0.5x to 1.5x today's 0.9-2.99 (the same sources; the book prints mg, data.js divides by 22.99)" } },
        "k": { "type": "number", "unit": "mmol K/100 mL", "sign": "positive",
          "range": { "lo": 0.68, "hi": 4, "proposed": "0.5x to 1.5x today's 1.37-2.65 (the same sources; mg / 39.10)" } },
        "ca": { "type": "number", "unit": "mg Ca/100 mL", "sign": "positive",
          "range": { "lo": 13, "hi": 180, "proposed": "0.5x to 1.5x today's 26-116 (the same sources)" } },
        "p": { "type": "number", "unit": "mg P/100 mL", "sign": "positive",
          "range": { "lo": 7.4, "hi": 110, "proposed": "0.5x to 1.5x today's 14.9-69.3 (the same sources)" } },
        "osm": { "type": "number", "unit": "mOsm/kg H2O", "sign": "positive",
          "nullable": "the source gives no osmolality at this strength (data.js EN_DB note); only the Formula page shows it",
          "range": { "lo": 85, "hi": 540, "proposed": "0.5x to 1.5x today's 170-360 (Chula Handbook Tables 5, 7, 16, at the strength the book prints)" } },
        "lf": { "type": "boolean" },
        "source": { "type": "text", "optional": true },
        "note": { "type": "text", "optional": true },
        "unsourced": { "type": "boolean", "optional": true }
      }
    },
    "KCMH_STOCK": {
      "what": "The KCMH pharmacy shelf: what one mL of each stock holds. Every printed stock mL divides by one of these.",
      "columns": {
        "label": { "type": "text" },
        "short": { "type": "text", "optional": true },
        "caution": { "type": "text", "optional": true },
        "gPerMl": { "type": "number", "unit": "g/mL", "sign": "positive", "optional": true, "range": "rule" },
        "naMeqPerMl": { "type": "number", "unit": "mEq Na/mL", "sign": "positive", "optional": true, "range": "rule" },
        "acetateMeqPerMl": { "type": "number", "unit": "mEq acetate/mL", "sign": "positive", "optional": true, "range": "rule",
          "nullable": "the vial label has not been read; CR-U-SALTS codes null and the Calculator shows no acetate" },
        "pMgPerMl": { "type": "number", "unit": "mg P/mL", "sign": "positive", "optional": true, "range": "rule" },
        "kMeqPerMl": { "type": "number", "unit": "mEq K/mL", "sign": "positive", "optional": true, "range": "rule" },
        "pMgPerKMeq": { "type": "number", "unit": "mg P/mEq K", "sign": "positive", "optional": true, "range": "rule" },
        "mgMeqPerMl": { "type": "number", "unit": "mEq Mg/mL", "sign": "positive", "optional": true, "range": "rule" },
        "caMgPerMl": { "type": "number", "unit": "mg elemental Ca/mL", "sign": "positive", "optional": true, "range": "rule" },
        "caMeqPerMl": { "type": "number", "unit": "mEq Ca/mL", "sign": "positive", "optional": true, "range": "rule" },
        "mlPerKg": { "type": "number", "unit": "mL/kg/d", "sign": "positive", "optional": true, "range": "rule" },
        "maxMl": { "type": "number", "unit": "mL/d", "sign": "positive", "optional": true, "range": "rule" },
        "znMgPerMl": { "type": "number", "unit": "mg elemental Zn/mL", "sign": "positive", "optional": true, "range": "rule" },
        "unitsPerMl": { "type": "number", "unit": "U heparin/mL", "sign": "positive", "optional": true, "range": "rule" }
      },
      "cells": {
        "aminoplasmal15.gPerMl": { "lo": 0.15, "hi": 0.15,
          "proposed": "B. Braun Aminoplasmal 15%, 150 g/L (UK SmPC, docs/CLINICAL_CONSTANTS.md); offered on no ward today" },
        "caGluconate.caMeqPerMl": { "lo": 0.45, "hi": 0.45, "rule": "CR-U-SALTS",
          "why": "its stock table: 9.01755 mg/mL (0.45 mEq)" }
      }
    },
    "SUPP_DB": {
      "what": "Oral supplements on the Calculator's Step 5: strengths per mL, drop or tablet. The copied order and the vitamin D caution read them.",
      "columns": {
        "label": { "type": "text" },
        "category": { "type": "text" },
        "form": { "type": "text" },
        "unitLabel": { "type": "text" },
        "note": { "type": "text", "optional": true },
        "unitVol": { "type": "number", "unit": "mL or tablets per unit", "sign": "positive",
          "range": { "lo": 0.5, "hi": 7.5, "proposed": "0.5x to 1.5x today's 1-5 (the units in each row's note)" } },
        "dose_default": { "type": "number", "unit": "mL/d", "sign": "positive", "optional": true,
          "range": { "lo": 0.5, "hi": 1.5, "proposed": "0.5x to 1.5x today's 1 (Munti-vim, 1 mL/day in its note)" } },
        "vitD_iu_per_ml": { "type": "number", "unit": "IU vitamin D/mL", "sign": "positive", "optional": true,
          "range": { "lo": 200, "hi": 600, "proposed": "0.5x to 1.5x today's 400 (Munti-vim's note)" } },
        "vitA_iu_per_ml": { "type": "number", "unit": "IU vitamin A/mL", "sign": "positive", "optional": true,
          "range": { "lo": 1000, "hi": 3000, "proposed": "0.5x to 1.5x today's 2000 (Munti-vim)" } },
        "vitC_mg_per_ml": { "type": "number", "unit": "mg vitamin C/mL", "sign": "positive", "optional": true,
          "range": { "lo": 20, "hi": 60, "proposed": "0.5x to 1.5x today's 40 (Munti-vim)" } },
        "b1_mg_per_ml": { "type": "number", "unit": "mg vitamin B1/mL", "sign": "positive", "optional": true,
          "range": { "lo": 1, "hi": 3, "proposed": "0.5x to 1.5x today's 2 (Munti-vim)" } },
        "b2_mg_per_ml": { "type": "number", "unit": "mg vitamin B2/mL", "sign": "positive", "optional": true,
          "range": { "lo": 1, "hi": 3, "proposed": "0.5x to 1.5x today's 2 (Munti-vim)" } },
        "b3_mg_per_ml": { "type": "number", "unit": "mg vitamin B3/mL", "sign": "positive", "optional": true,
          "range": { "lo": 7.5, "hi": 23, "proposed": "0.5x to 1.5x today's 15 (Munti-vim)" } },
        "b6_mg_per_ml": { "type": "number", "unit": "mg vitamin B6/mL", "sign": "positive", "optional": true,
          "range": { "lo": 0.9, "hi": 2.7, "proposed": "0.5x to 1.5x today's 1.8 (Munti-vim)" } },
        "b12_mcg_per_ml": { "type": "number", "unit": "microgram vitamin B12/mL", "sign": "positive", "optional": true,
          "range": { "lo": 2.5, "hi": 7.5, "proposed": "0.5x to 1.5x today's 5 (Munti-vim)" } },
        "ca_mg_per_ml": { "type": "number", "unit": "mg Ca/mL", "sign": "positive", "optional": true,
          "range": { "lo": 2.5, "hi": 7.5, "proposed": "0.5x to 1.5x today's 5 (Munti-vim)" } },
        "po4_mg_per_ml": { "type": "number", "unit": "mg PO4/mL", "sign": "positive", "optional": true,
          "range": { "lo": 7.2, "hi": 80, "proposed": "0.5x to 1.5x today's 14.4-53 (Phosphate Solution 265 mg/5 mL, Neutral Phos 72 mg/5 mL, in their notes)" } },
        "po4_mmol_per_ml": { "type": "number", "unit": "mmol PO4/mL", "sign": "positive", "optional": true,
          "range": { "lo": 0.23, "hi": 2.6, "proposed": "0.5x to 1.5x today's 0.46-1.71 (the same notes)" } },
        "na_meq_per_ml": { "type": "number", "unit": "mEq Na/mL", "sign": "positive", "optional": true,
          "range": { "lo": 0.047, "hi": 1.5, "proposed": "0.5x to 1.5x today's 0.095-0.988 (the same notes)" } },
        "k_meq_per_ml": { "type": "number", "unit": "mEq K/mL", "sign": "nonnegative", "optional": true,
          "range": { "lo": 0, "hi": 0.15, "proposed": "0 to 1.5x today's 0.095 (Neutral Phos; Phosphate Solution has none)" } },
        "fe_mg_per_ml": { "type": "number", "unit": "mg elemental Fe/mL", "sign": "positive", "optional": true,
          "range": { "lo": 2.5, "hi": 38, "proposed": "0.5x to 1.5x today's 5-25 (Ferrokid, Ferdek, in their notes)" } },
        "ca_mg_per_unit": { "type": "number", "unit": "mg elemental Ca/tablet", "sign": "positive", "optional": true,
          "range": { "lo": 70, "hi": 600, "proposed": "0.5x to 1.5x today's 140-400 (CaCO3 350 and 1000 mg, Calcetate, in their notes)" } },
        "ca_meq_per_unit": { "type": "number", "unit": "mEq Ca/tablet", "sign": "positive", "optional": true,
          "range": { "lo": 3.5, "hi": 30, "proposed": "0.5x to 1.5x today's 7-20 (the same notes)" } },
        "vitD_iu_per_drop": { "type": "number", "unit": "IU vitamin D/drop", "sign": "positive", "optional": true,
          "range": { "lo": 200, "hi": 600, "proposed": "0.5x to 1.5x today's 400 (generic D3 drops, its note)" } }
      }
    }
  },
  "categories": {
    "SUPP_DB": { "column": "category", "values": ["mtv", "po4", "fe", "ca", "vitd"] }
  },
  "defaults": {
    "enType": { "table": "EN_DB" },
    "suppCaType": { "table": "SUPP_DB", "category": "ca" },
    "suppPO4Type": { "table": "SUPP_DB", "category": "po4" },
    "suppFeType": { "table": "SUPP_DB", "category": "fe" }
  },
  "nursingFeedTable": "EN_DB",
  "limits": {
