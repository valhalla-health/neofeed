    "EN_FEEDS_PER_DAY_MAX": { "unit": "feeds/day, Feed 1 + Feed 2", "sign": "positive" },
    "PROTEIN_HARD_HI": { "unit": "g/kg/d", "sign": "positive" },
    "LIPID_IV_HARD_HI": { "unit": "g/kg/d", "sign": "positive" },
