    "LIPID_GKGH.max": { "unit": "g/kg/h", "sign": "positive" },
    "K_IV_HARD_HI": { "unit": "mEq/kg/d", "sign": "positive" },
    "KCAL_HARD_HI": { "unit": "kcal/kg/d", "sign": "positive" },
    "MAX_ZN_MG_DAY": { "unit": "mg elemental Zn/d", "sign": "positive" },
    "NPE_IV_CRIT_LO": { "unit": "kcal non-protein/g amino acid", "sign": "positive" },
    "HEPARIN_USUAL_MAX_U_ML": { "unit": "U/mL of the prepared bag", "sign": "positive" },
    "VIT_D_MAX_IU_DAY": { "unit": "IU/d", "sign": "positive" },
    "MEN_MAX_ML_KG": { "unit": "mL/kg/d", "sign": "positive" },
    "NEWBORN_DEAD_VOL_ML": { "unit": "mL/d", "sign": "positive" },
    "FIRST_DAYS_LAST_DOL": { "unit": "day of life", "sign": "positive" },
    "OLDER_CHILD_WARDS": { "type": "list", "unit": "ward names" },
    "MG_MG_PER_MEQ": { "unit": "mg Mg/mEq", "sign": "positive",
