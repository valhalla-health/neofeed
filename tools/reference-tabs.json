      "lipid": { "args": "none", "unit": "g/kg/d",
        "within": { "lo": 2.4, "hi": 13, "proposed": "0.5x to 1.5x today's 4.8-8.1 (ESPGHAN 2022, data.js)" } },
      "na": { "args": "none", "unit": "mmol/kg/d", "within": { "backend": "na" } },
      "k": { "args": "none", "unit": "mmol/kg/d", "within": { "backend": "k" } },
      "ca": { "args": "none", "unit": "mg/kg/d", "within": { "backend": "ca" } },
