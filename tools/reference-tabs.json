    "K_BAG_MEQ_PER_L.peripheral.warn": { "unit": "mEq K/L of the prepared bag", "sign": "positive" },
    "K_BAG_MEQ_PER_L.peripheral.red": { "unit": "mEq K/L of the prepared bag", "sign": "positive" },
    "K_BAG_MEQ_PER_L.peripheral.hardMax": { "unit": "mEq K/L of the prepared bag", "sign": "positive" },
    "K_BAG_MEQ_PER_L.central.warn": { "unit": "mEq K/L of the prepared bag", "sign": "positive" },
    "K_BAG_MEQ_PER_L.central.red": { "unit": "mEq K/L of the prepared bag", "sign": "positive" },
    "K_BAG_MEQ_PER_L.central.hardMax": { "unit": "mEq K/L of the prepared bag", "sign": "positive" },
    "TPN_BOTTLE_MAX_ML": { "unit": "mL prepared", "sign": "positive" },
