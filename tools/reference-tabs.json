    },
    "TARGETS": {
      "fluid": { "args": "dol,wtG,bwG", "unit": "mL/kg/d", "within": { "backend": "fluid" } },
      "gir": { "args": "none", "unit": "mg/kg/min", "within": { "backend": "gir" }, "hiAtMost": "GIR_HARD_HI" },
      "girTarget": { "args": "none", "unit": "mg/kg/min", "within": { "backend": "gir" }, "hiAtMost": "GIR_HARD_HI" },
      "girPreterm": { "args": "none", "shape": "object", "unit": "mg/kg/min", "within": { "backend": "gir" }, "hiAtMost": "GIR_HARD_HI" },
      "girTerm": { "args": "none", "shape": "object", "unit": "mg/kg/min", "within": { "backend": "gir" }, "hiAtMost": "GIR_HARD_HI" },
      "protein": { "args": "dol", "unit": "g/kg/d", "within": { "backend": "pro" }, "hiAtMost": "PROTEIN_HARD_HI" },
      "kcal": { "args": "dol", "unit": "kcal/kg/d", "within": { "backend": "kcal" }, "hiAtMost": "KCAL_HARD_HI" },
      "lipid": { "args": "dol", "unit": "g/kg/d",
        "within": { "lo": 0.25, "hi": 13, "proposed": "0.5x to 1.5x today's 0.5-8.1 (ESPGHAN 2018 and 2022, data.js)" } },
      "na": { "args": "dol,wtG,bwG", "unit": "mEq/kg/d", "within": { "backend": "na" } },
      "k": { "args": "dol,wtG,bwG", "unit": "mEq/kg/d", "within": { "backend": "k" }, "hiAtMost": "K_IV_HARD_HI" },
