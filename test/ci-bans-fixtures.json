  { "rule": "raw-tofixed", "expect": "fail", "name": "precision from a variable",
    "code": "const label = vol.toFixed(d) + \" mL\";" },
  { "rule": "raw-tofixed", "expect": "fail", "name": "an argument to another call",
    "code": "alerts.push(msg(calc.osm.toFixed(1)));" },
  { "rule": "raw-tofixed", "expect": "fail", "name": "the SVG allow entry does not cover another file",
